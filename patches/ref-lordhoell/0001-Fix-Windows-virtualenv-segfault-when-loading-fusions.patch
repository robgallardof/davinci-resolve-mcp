From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: robgallardof <robgallardof@gmail.com>
Date: Sat, 3 Oct 2026 23:08:36 -0600
Subject: [PATCH] Fix Windows virtualenv segfault when loading fusionscript;
 clearer errors; pin mcp<2

- resolve_connection: on Windows, loading fusionscript.dll from inside a
  virtualenv (the uv/pip setup the README describes) crashed the process with a
  segfault. Sets PYTHONHOME to the base interpreter first (respecting an
  existing value). Verified on Windows 11 + Resolve 21.0.4: exit 139 before, a
  normal Python error after.
- The connection error now names the real causes: no project open, external
  scripting disabled in Preferences, or the Free edition, which refuses external
  scripting.
- comp_lock: documents that value writes (inputs, keyframes) made while the comp
  is locked read back but are ignored at render. Lock only around structural edits.
- pyproject: mcp<2. mcp 2.x renamed FastMCP; a fresh install would not start.
- tests/test_resolve_connection.py: 4 tests (PYTHONHOME in a Windows venv, an
  existing value respected, untouched elsewhere, error message).
---
 pyproject.toml                                |  2 +-
 src/davinci_resolve_mcp/resolve_connection.py | 11 +++-
 src/davinci_resolve_mcp/tools/fusion_comp.py  |  4 ++
 tests/test_resolve_connection.py              | 54 +++++++++++++++++++
 4 files changed, 68 insertions(+), 3 deletions(-)
 create mode 100644 tests/test_resolve_connection.py

diff --git a/pyproject.toml b/pyproject.toml
index 8ffeb7c..42ba3e1 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -21,7 +21,7 @@ classifiers = [
     "Topic :: Multimedia :: Video",
 ]
 dependencies = [
-    "mcp[cli]>=1.0",
+    "mcp[cli]>=1.0,<2",  # 2.x renamed FastMCP; this server targets the 1.x API
 ]
 
 [project.scripts]
diff --git a/src/davinci_resolve_mcp/resolve_connection.py b/src/davinci_resolve_mcp/resolve_connection.py
index 4b011ea..69f024e 100644
--- a/src/davinci_resolve_mcp/resolve_connection.py
+++ b/src/davinci_resolve_mcp/resolve_connection.py
@@ -30,6 +30,12 @@ def _get_resolve_script_module():
     2. Check RESOLVE_SCRIPT_LIB environment variable
     3. Fall back to default platform-specific install paths
     """
+    # fusionscript embeds Python. On Windows, loading it from inside a virtualenv
+    # (the uv/pip setup this project documents) crashes the whole process with a
+    # segfault unless PYTHONHOME names the base interpreter.
+    if (sys.platform.startswith("win") or sys.platform.startswith("cygwin")) and sys.prefix != sys.base_prefix:
+        os.environ.setdefault("PYTHONHOME", sys.base_prefix)
+
     # 1. Direct import
     try:
         import fusionscript
@@ -90,8 +96,9 @@ class ResolveConnection:
         self.resolve = self._script_module.scriptapp("Resolve")
         if self.resolve is None:
             raise ConnectionError(
-                "Could not connect to DaVinci Resolve. "
-                "Make sure DaVinci Resolve is running before starting the MCP server."
+                "Could not connect to DaVinci Resolve. Make sure it is running with a project open "
+                "and Preferences > System > General > External scripting using is set to Local. "
+                "The Free edition does not accept external scripting connections."
             )
         logger.info(f"Connected to DaVinci Resolve {self.resolve.GetVersionString()}")
 
diff --git a/src/davinci_resolve_mcp/tools/fusion_comp.py b/src/davinci_resolve_mcp/tools/fusion_comp.py
index de48935..039d962 100644
--- a/src/davinci_resolve_mcp/tools/fusion_comp.py
+++ b/src/davinci_resolve_mcp/tools/fusion_comp.py
@@ -493,6 +493,10 @@ def comp_lock(comp_id: str) -> str:
 
     Always pair with comp_unlock(). Failing to unlock will freeze the UI.
 
+    Only use it around STRUCTURAL edits (adding/connecting tools). Value writes made while
+    the comp is locked (input values, keyframes) read back correctly but are ignored when
+    Resolve renders the clip: set values after comp_unlock().
+
     Args:
         comp_id: FusionComp ID
     """
diff --git a/tests/test_resolve_connection.py b/tests/test_resolve_connection.py
new file mode 100644
index 0000000..896ae00
--- /dev/null
+++ b/tests/test_resolve_connection.py
@@ -0,0 +1,54 @@
+"""Loading fusionscript must not crash Windows virtualenvs, and failures must say why."""
+
+import pytest
+
+from davinci_resolve_mcp import resolve_connection as rc
+
+
+class FakeModule:
+    def __init__(self, app):
+        self.app = app
+
+    def scriptapp(self, name):
+        return self.app
+
+
+@pytest.fixture
+def no_real_fusionscript(monkeypatch):
+    """Never touch the real native library in unit tests."""
+    monkeypatch.setattr(rc, "_load_dynamic", lambda name, path: FakeModule(None))
+    monkeypatch.delenv("RESOLVE_SCRIPT_LIB", raising=False)
+    monkeypatch.setitem(__import__("sys").modules, "fusionscript", None)  # direct import fails
+
+
+def test_windows_virtualenv_gets_pythonhome(monkeypatch, no_real_fusionscript):
+    monkeypatch.setattr(rc.sys, "platform", "win32")
+    monkeypatch.setattr(rc.sys, "prefix", r"C:\project\.venv")
+    monkeypatch.setattr(rc.sys, "base_prefix", r"C:\Python312")
+    monkeypatch.delenv("PYTHONHOME", raising=False)
+    rc._get_resolve_script_module()
+    assert rc.os.environ["PYTHONHOME"] == r"C:\Python312"
+
+
+def test_existing_pythonhome_is_respected(monkeypatch, no_real_fusionscript):
+    monkeypatch.setattr(rc.sys, "platform", "win32")
+    monkeypatch.setattr(rc.sys, "prefix", r"C:\project\.venv")
+    monkeypatch.setattr(rc.sys, "base_prefix", r"C:\Python312")
+    monkeypatch.setenv("PYTHONHOME", r"D:\custom")
+    rc._get_resolve_script_module()
+    assert rc.os.environ["PYTHONHOME"] == r"D:\custom"
+
+
+def test_not_set_outside_windows_or_venv(monkeypatch, no_real_fusionscript):
+    monkeypatch.delenv("PYTHONHOME", raising=False)
+    monkeypatch.setattr(rc.sys, "platform", "linux")
+    monkeypatch.setattr(rc.sys, "prefix", "/venv")
+    monkeypatch.setattr(rc.sys, "base_prefix", "/usr")
+    rc._get_resolve_script_module()
+    assert "PYTHONHOME" not in rc.os.environ
+
+
+def test_connection_error_explains_free_edition(monkeypatch, no_real_fusionscript):
+    conn = rc.ResolveConnection()
+    with pytest.raises(ConnectionError, match="Free edition"):
+        conn.connect()
