+def _prepare_environment():
+    """What DaVinciResolveScript expects before import, on every OS.
+
+    On Windows, fusionscript.dll embeds Python and crashes the whole process (segfault)
+    inside a virtualenv unless PYTHONHOME names the base interpreter.
+    """
+    os.environ.setdefault("RESOLVE_SCRIPT_API", scripting_api_dir())
+    os.environ.setdefault("RESOLVE_SCRIPT_LIB", scripting_lib())
+    if sys.platform.startswith("win") and sys.prefix != sys.base_prefix:
+        os.environ.setdefault("PYTHONHOME", sys.base_prefix)
 
 _instance = None
 
@@ -33,6 +48,7 @@ class ResolveConnection:
 
     def _connect(self):
         """Connect to DaVinci Resolve via scripting API."""
+        _prepare_environment()
         if RESOLVE_SCRIPT_PATH not in sys.path:
             sys.path.append(RESOLVE_SCRIPT_PATH)
         try:
@@ -41,7 +57,9 @@ class ResolveConnection:
             if self._resolve:
                 logger.info("Connected to DaVinci Resolve")
             else:
-                logger.warning("DaVinci Resolve is not running")
