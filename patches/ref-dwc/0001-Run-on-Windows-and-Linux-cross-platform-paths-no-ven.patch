diff --git a/tests/test_paths.py b/tests/test_paths.py
new file mode 100644
index 0000000..a4e3dd4
--- /dev/null
+++ b/tests/test_paths.py
@@ -0,0 +1,37 @@
+"""The server must find Resolve's scripting module and LUTs on macOS, Windows and Linux."""
+
+from resolve_mcp.paths import lut_dirs, scripting_api_dir, scripting_lib, scripting_modules_dir
+
+WIN_ENV = {"PROGRAMDATA": r"C:\ProgramData", "PROGRAMFILES": r"C:\Program Files",
+           "APPDATA": r"C:\Users\me\AppData\Roaming"}
+
+
+def test_macos_paths_are_unchanged():
+    assert scripting_modules_dir("darwin", {}) == (
+        "/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting/Modules")
+    assert scripting_lib("darwin", {}).endswith("Contents/Libraries/Fusion/fusionscript.so")
+    assert lut_dirs("darwin", {"HOME": "/Users/me"})[1] == (
+        "/Users/me/Library/Application Support/Blackmagic Design/DaVinci Resolve/LUT")
+
+
+def test_windows_paths():
+    assert scripting_modules_dir("win32", WIN_ENV) == (
+        r"C:\ProgramData\Blackmagic Design\DaVinci Resolve\Support\Developer\Scripting\Modules")
+    assert scripting_lib("win32", WIN_ENV) == r"C:\Program Files\Blackmagic Design\DaVinci Resolve\fusionscript.dll"
+    assert lut_dirs("win32", WIN_ENV) == [
+        r"C:\ProgramData\Blackmagic Design\DaVinci Resolve\Support\LUT",
+        r"C:\Users\me\AppData\Roaming\Blackmagic Design\DaVinci Resolve\Support\LUT",
+    ]
+
+
+def test_linux_paths():
+    assert scripting_modules_dir("linux", {}) == "/opt/resolve/Developer/Scripting/Modules"
+    assert scripting_lib("linux", {}) == "/opt/resolve/libs/Fusion/fusionscript.so"
+    assert lut_dirs("linux", {"HOME": "/home/me"})[0] == "/opt/resolve/LUT"
+
+
+def test_environment_overrides():
+    env = {"RESOLVE_SCRIPT_API": "/custom/api", "RESOLVE_SCRIPT_LIB": "/custom/lib.so"}
+    assert scripting_api_dir("linux", env) == "/custom/api"
+    assert scripting_modules_dir("linux", env) == "/custom/api/Modules"
+    assert scripting_lib("win32", env) == "/custom/lib.so"
