diff --git a/src/resolve_mcp/paths.py b/src/resolve_mcp/paths.py
new file mode 100644
index 0000000..620b7bb
--- /dev/null
+++ b/src/resolve_mcp/paths.py
@@ -0,0 +1,69 @@
+"""Where DaVinci Resolve keeps its scripting module and LUTs, per operating system.
+
+The server used hard-coded macOS paths, so it could not connect on Windows or Linux and the
+LUT tools never found anything there. Values follow Blackmagic's scripting README; the
+RESOLVE_SCRIPT_API / RESOLVE_SCRIPT_LIB environment variables still win when set.
+"""
+
+import os
+import sys
+from typing import List, Mapping, Optional
+
+_MAC_API = "/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting"
+_MAC_LIB = "/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so"
+_LINUX_API = "/opt/resolve/Developer/Scripting"
+_LINUX_LIB = "/opt/resolve/libs/Fusion/fusionscript.so"
+
+
+def _platform(platform: Optional[str]) -> str:
+    return platform or sys.platform
+
+
+def scripting_api_dir(platform: Optional[str] = None, env: Optional[Mapping[str, str]] = None) -> str:
+    env = os.environ if env is None else env
+    if env.get("RESOLVE_SCRIPT_API"):
+        return env["RESOLVE_SCRIPT_API"]
+    plat = _platform(platform)
+    if plat.startswith("win"):
+        program_data = env.get("PROGRAMDATA", r"C:\ProgramData")
+        return program_data + r"\Blackmagic Design\DaVinci Resolve\Support\Developer\Scripting"
+    if plat.startswith("linux"):
+        return _LINUX_API
+    return _MAC_API
+
+
+def scripting_modules_dir(platform: Optional[str] = None, env: Optional[Mapping[str, str]] = None) -> str:
+    sep = "\\" if _platform(platform).startswith("win") else "/"
+    return scripting_api_dir(platform, env) + sep + "Modules"
+
+
+def scripting_lib(platform: Optional[str] = None, env: Optional[Mapping[str, str]] = None) -> str:
+    env = os.environ if env is None else env
+    if env.get("RESOLVE_SCRIPT_LIB"):
+        return env["RESOLVE_SCRIPT_LIB"]
+    plat = _platform(platform)
+    if plat.startswith("win"):
+        program_files = env.get("PROGRAMFILES", r"C:\Program Files")
+        return program_files + r"\Blackmagic Design\DaVinci Resolve\fusionscript.dll"
+    if plat.startswith("linux"):
+        return _LINUX_LIB
+    return _MAC_LIB
+
+
+def lut_dirs(platform: Optional[str] = None, env: Optional[Mapping[str, str]] = None) -> List[str]:
+    """System-wide first, then per-user LUT folders."""
+    env = os.environ if env is None else env
+    plat = _platform(platform)
+    if plat.startswith("win"):
+        program_data = env.get("PROGRAMDATA", r"C:\ProgramData")
+        app_data = env.get("APPDATA", "")
+        dirs = [program_data + r"\Blackmagic Design\DaVinci Resolve\Support\LUT"]
+        if app_data:
+            dirs.append(app_data + r"\Blackmagic Design\DaVinci Resolve\Support\LUT")
+        return dirs
+    if plat.startswith("linux"):
+        home = env.get("HOME", "~")
+        return ["/opt/resolve/LUT", home + "/.local/share/DaVinciResolve/LUT"]
+    home = env.get("HOME", "~")
+    return ["/Library/Application Support/Blackmagic Design/DaVinci Resolve/LUT",
+            home + "/Library/Application Support/Blackmagic Design/DaVinci Resolve/LUT"]
