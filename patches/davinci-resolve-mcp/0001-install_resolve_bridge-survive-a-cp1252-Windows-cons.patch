From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: robgallardof <robgallardof@gmail.com>
Date: Sat, 3 Oct 2026 23:09:38 -0600
Subject: [PATCH] install_resolve_bridge: survive a cp1252 Windows console
 (same guard as install.py #150)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The script's own help text and install summary contain '▸' and '•'. On a legacy
Windows console (cp1252, the default for cmd and Windows PowerShell 5.1), even
`python scripts/install_resolve_bridge.py --help` died with
UnicodeEncodeError: 'charmap' codec can't encode character '▸'.

install.py already guards against this (#150); the bridge installer, which the
README tells Free-edition users to run next, did not. main() now applies the same
_ensure_glyph_capable_stdio(): only streams that cannot encode the glyphs are
switched to UTF-8 with errors="replace".

tests/test_install_resolve_bridge_console.py runs --help with
PYTHONIOENCODING=cp1252: it fails before this change and passes after.
---
 scripts/install_resolve_bridge.py            | 28 ++++++++++++++++++++
 tests/test_install_resolve_bridge_console.py | 16 +++++++++++
 2 files changed, 44 insertions(+)
 create mode 100644 tests/test_install_resolve_bridge_console.py

diff --git a/scripts/install_resolve_bridge.py b/scripts/install_resolve_bridge.py
index 511842b..912148a 100644
--- a/scripts/install_resolve_bridge.py
+++ b/scripts/install_resolve_bridge.py
@@ -755,7 +755,35 @@ def next_steps(result: dict) -> list:
     return lines
 
 
+_GLYPH_PROBE = "▸•─→✓"
+
+
+def _ensure_glyph_capable_stdio() -> None:
+    """Same guard install.py has (#150): a Windows cp1252 console cannot encode the
+    '▸' in this script's own help text and status lines, so `--help` (and the
+    install summary) died with UnicodeEncodeError. Only streams that cannot carry
+    the glyphs are switched to UTF-8; 'replace' keeps any output path from raising."""
+    for stream in (sys.stdout, sys.stderr):
+        reconfigure = getattr(stream, "reconfigure", None)
+        encoding = getattr(stream, "encoding", None)
+        if reconfigure is None or not encoding:
+            continue
+        try:
+            _GLYPH_PROBE.encode(encoding)
+            continue
+        except (LookupError, UnicodeEncodeError):
+            pass
+        try:
+            reconfigure(encoding="utf-8", errors="replace")
+        except Exception:
+            try:
+                reconfigure(errors="replace")
+            except Exception:
+                pass
+
+
 def main() -> int:
+    _ensure_glyph_capable_stdio()
     parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument("--probe-only", action="store_true",
                         help="install only the host-model probe (run this first)")
diff --git a/tests/test_install_resolve_bridge_console.py b/tests/test_install_resolve_bridge_console.py
new file mode 100644
index 0000000..ca3a9de
--- /dev/null
+++ b/tests/test_install_resolve_bridge_console.py
@@ -0,0 +1,16 @@
+"""install_resolve_bridge.py must not crash on a legacy (cp1252) Windows console."""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "install_resolve_bridge.py"
+
+
+def test_help_survives_a_cp1252_console():
+    env = {**os.environ, "PYTHONIOENCODING": "cp1252", "PYTHONUTF8": "0"}
+    proc = subprocess.run([sys.executable, str(SCRIPT), "--help"], capture_output=True, env=env, timeout=60)
+    assert proc.returncode == 0, proc.stderr.decode("utf-8", "replace")[-500:]
+    assert b"UnicodeEncodeError" not in proc.stderr
+    assert b"--probe-only" in proc.stdout
