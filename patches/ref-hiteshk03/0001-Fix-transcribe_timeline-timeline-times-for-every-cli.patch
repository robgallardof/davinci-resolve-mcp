diff --git a/src/transcript_mapping.py b/src/transcript_mapping.py
new file mode 100644
index 0000000..3d80098
--- /dev/null
+++ b/src/transcript_mapping.py
@@ -0,0 +1,59 @@
+"""Map source-file transcription onto the edited timeline.
+
+transcribe_timeline used to transcribe only the first clip's whole source file and return
+SOURCE times, so on any edited timeline the timestamps pointed to the wrong place and the
+speech of every other clip was missing. These pure helpers re-time each clip's words to where
+that clip actually sits on the timeline. No Resolve, no MCP: unit-testable.
+"""
+
+from typing import Any, Dict, List, Optional, Tuple
+
+
+def _num(value: Any, default: float = 0.0) -> float:
+    try:
+        return float(value)
+    except (TypeError, ValueError):
+        return default
+
+
+def clip_window(clip: Dict[str, Any], timeline_fps: float, timeline_start: int) -> Optional[Tuple[float, float, float]]:
+    """(source_in_s, source_out_s, timeline_at_s) for one clip from /timeline/clips, or None.
+
+    Uses leftOffset (exact source in-point, in source frames) and the clip's own FPS; the
+    duration is in timeline frames.
+    """
+    if not clip.get("File Path"):
+        return None
+    src_fps = _num(clip.get("FPS"), timeline_fps) or timeline_fps
+    src_in = _num(clip.get("leftOffset")) / src_fps
+    src_out = src_in + _num(clip.get("duration")) / timeline_fps
+    at = (_num(clip.get("start")) - timeline_start) / timeline_fps
+    return src_in, src_out, at
+
+
+def map_segments(segments: List[Dict[str, Any]], src_in: float, src_out: float, at: float) -> List[Dict[str, Any]]:
+    """Keep the words spoken inside [src_in, src_out) and shift them to timeline time."""
+    shift = at - src_in
+    out = []
+    for seg in segments:
+        words = [w for w in seg.get("words", []) if src_in <= (w["start"] + w["end"]) / 2 < src_out]
+        if words:
+            moved = [{**w, "start": round(max(w["start"], src_in) + shift, 2),
+                      "end": round(min(w["end"], src_out) + shift, 2)} for w in words]
+            out.append({"start": moved[0]["start"], "end": moved[-1]["end"],
+                        "text": " ".join(w["word"] for w in moved), "words": moved})
+        elif not seg.get("words") and src_in <= (seg["start"] + seg["end"]) / 2 < src_out:
+            out.append({**seg, "start": round(max(seg["start"], src_in) + shift, 2),
+                        "end": round(min(seg["end"], src_out) + shift, 2)})
+    return out
+
+
+def map_to_timeline(clips: List[Dict[str, Any]], transcripts: Dict[str, List[Dict[str, Any]]],
+                    timeline_fps: float, timeline_start: int) -> List[Dict[str, Any]]:
+    """All clips' speech in timeline order. `transcripts` maps a source path to its segments."""
+    out: List[Dict[str, Any]] = []
+    for clip in clips:
+        window = clip_window(clip, timeline_fps, timeline_start)
+        if window and clip["File Path"] in transcripts:
+            out.extend(map_segments(transcripts[clip["File Path"]], *window))
+    return sorted(out, key=lambda s: s["start"])
diff --git a/tests/test_transcript_mapping.py b/tests/test_transcript_mapping.py
new file mode 100644
index 0000000..505567e
--- /dev/null
+++ b/tests/test_transcript_mapping.py
@@ -0,0 +1,47 @@
+"""transcribe_timeline must return TIMELINE times for every clip, not the first clip's source times."""
+
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))
+
+from transcript_mapping import clip_window, map_segments, map_to_timeline  # noqa: E402
+
+
+def seg(*words):
+    ws = [{"word": w, "start": s, "end": s + 0.3, "probability": 0.9} for w, s in words]
+    return {"start": ws[0]["start"], "end": ws[-1]["end"], "text": " ".join(w for w, _ in words), "words": ws}
+
+
+SOURCE = {"C:/take.mp4": [seg(("hola", 0.2), ("a", 0.6), ("todos", 0.9)),
+                          seg(("hoy", 12.0), ("limpio", 12.4)),
+                          seg(("fuera", 30.0))]}
+# Timeline at 30 fps starting at 01:00:00:00 (86400 at 24 fps would differ; use the reported startFrame).
+CLIPS = [
+    {"File Path": "C:/take.mp4", "FPS": "30", "start": 108000, "duration": 300, "leftOffset": 0},     # src 0-10 at 0 s
+    {"File Path": "C:/take.mp4", "FPS": "30", "start": 108300, "duration": 300, "leftOffset": 360},   # src 12-22 at 10 s
+]
+
+
+def test_clip_window_uses_left_offset_and_timeline_start():
+    assert clip_window(CLIPS[1], 30.0, 108000) == (12.0, 22.0, 10.0)
+    assert clip_window({"start": 0, "duration": 10}, 30.0, 0) is None  # titles/generators have no file
+
+
+def test_every_clip_is_mapped_to_timeline_time():
+    out = map_to_timeline(CLIPS, SOURCE, 30.0, 108000)
+    assert [s["text"] for s in out] == ["hola a todos", "hoy limpio"]
+    assert out[0]["start"] == 0.2
+    assert out[1]["start"] == 10.0  # was 12.0 (source time) before the fix
+    assert "fuera" not in " ".join(s["text"] for s in out)  # never on the timeline
+
+
+def test_word_cut_by_the_edit_is_clamped():
+    assert map_segments([seg(("antes", 11.6))], 12.0, 22.0, 10.0) == []  # midpoint 11.75: cut away
+    moved = map_segments([seg(("cortada", 11.9))], 12.0, 22.0, 10.0)      # midpoint 12.05: kept
+    assert moved[0]["start"] == 10.0 and moved[0]["end"] == 10.2          # clamped to the in-point
+
+
+def test_mixed_frame_rates():
+    clip = {"File Path": "a.mov", "FPS": "60", "start": 0, "duration": 120, "leftOffset": 600}
+    assert clip_window(clip, 30.0, 0) == (10.0, 14.0, 0.0)  # 600 source frames @60 = 10 s; 120 tl frames @30 = 4 s
